#!/usr/bin/env bash
# Generic command stub. Symlinked as tmux, wezterm, open. Records each call to
# $STUB_LOG and answers the few queries the scripts under test make.
name=$(basename "$0")
echo "$name $*" >> "${STUB_LOG:?STUB_LOG must be set}"

case "$name $*" in
  "tmux display -p -t %3 #S:#I.#P") echo "1:0.0" ;;
  "tmux display -p -t %3 #S")       echo "1" ;;
  "tmux display -p -t %9 #S")       echo "lonely" ;;
  "tmux list-clients -t 1 -F #{client_tty}") echo "/dev/ttys004" ;;
  "tmux list-clients -t lonely -F #{client_tty}") : ;;
  "wezterm cli list --format json")
    echo '[{"pane_id":3,"tty_name":"/dev/ttys004"},{"pane_id":17,"tty_name":"/dev/ttys023"}]' ;;
esac
[[ "$name" == "terminal-notifier" ]] && exit "${STUB_TN_EXIT:-0}"
exit 0
